{
  "name": "Thanh toán ecommerce — hoàn tiền & thu một phần",
  "description": "Mở rộng mô hình cơ bản: thu tiền toàn phần hoặc một phần, hoàn tiền từng phần và toàn phần, và bước đối soát với cổng. Số tiền được đo bằng đơn vị trừu tượng: 2 đơn vị là toàn bộ giá trị đơn hàng, 1 đơn vị là một nửa.",
  "assumptions": [
    "Backend xác minh nguồn webhook, số tiền và loại tiền trước khi tạo các input boolean.",
    "captured_units và refunded_units đo theo đơn vị trừu tượng, không phải số tiền thật; 2 = toàn bộ đơn hàng.",
    "Thu tiền một phần chỉ hợp lệ khi cổng và chính sách bán hàng cho phép, biểu diễn bằng input partial_authorized.",
    "Sự kiện được xử lý tuần tự theo đơn. Event ID được lưu bền vững để chống xử lý trùng.",
    "Đối soát được mô hình hóa như một sự kiện xác nhận, không phải sổ cái độc lập của ngân hàng.",
    "Chưa xét tranh chấp (chargeback), nhiều cổng song song hoặc tính sống (liveness)."
  ],
  "variables": {
    "status": {"label": "Trạng thái thanh toán", "values": ["CREATED", "PENDING", "UNKNOWN", "SUCCEEDED", "FAILED", "REFUNDED"], "initial": "CREATED"},
    "captured_units": {"label": "Số đơn vị tiền đã thu", "values": [0, 1, 2], "initial": 0},
    "refunded_units": {"label": "Số đơn vị tiền đã hoàn", "values": [0, 1, 2], "initial": 0},
    "capture_verified": {"label": "Có bằng chứng thu tiền hợp lệ", "values": [false, true], "initial": false},
    "shipped": {"label": "Đã yêu cầu giao hàng", "values": [false, true], "initial": false},
    "reconciled": {"label": "Đã đối soát với cổng", "values": [false, true], "initial": false}
  },
  "inputs": {
    "provider_verified": {"label": "Nguồn cổng đã xác thực", "values": [false, true], "initial": false},
    "amount_matches": {"label": "Số tiền khớp đơn hàng", "values": [false, true], "initial": false},
    "currency_matches": {"label": "Loại tiền khớp đơn hàng", "values": [false, true], "initial": false},
    "partial_authorized": {"label": "Chính sách cho phép thu một phần", "values": [false, true], "initial": false}
  },
  "transitions": [
    {"event": "start", "label": "Bắt đầu thanh toán", "from_states": ["CREATED"], "to_state": "PENDING", "guard": true, "effects": {}},
    {"event": "timeout", "label": "Mất phản hồi từ cổng", "from_states": ["PENDING"], "to_state": "UNKNOWN", "guard": true, "effects": {}},
    {"event": "capture_full", "label": "Thu tiền toàn phần", "from_states": ["PENDING", "UNKNOWN"], "to_state": "SUCCEEDED",
     "guard": {"and": ["$input.provider_verified", "$input.amount_matches", "$input.currency_matches", {"eq": ["$captured_units", 0]}]},
     "effects": {"capture_verified": true, "captured_units": 2}},
    {"event": "capture_partial", "label": "Thu tiền một phần", "from_states": ["PENDING", "UNKNOWN"], "to_state": "SUCCEEDED",
     "guard": {"and": ["$input.provider_verified", "$input.currency_matches", "$input.partial_authorized", {"eq": ["$captured_units", 0]}]},
     "effects": {"capture_verified": true, "captured_units": 1}},
    {"event": "fail", "label": "Cổng xác nhận thất bại", "from_states": ["PENDING", "UNKNOWN"], "to_state": "FAILED", "guard": "$input.provider_verified", "effects": {}},
    {"event": "retry", "label": "Thử lại sau thất bại", "from_states": ["FAILED"], "to_state": "PENDING", "guard": {"eq": ["$captured_units", 0]}, "effects": {}},
    {"event": "ship", "label": "Yêu cầu giao hàng", "from_states": ["SUCCEEDED"], "to_state": "SUCCEEDED",
     "guard": {"and": ["$capture_verified", {"eq": ["$captured_units", 2]}, {"eq": ["$refunded_units", 0]}, {"not": ["$shipped"]}]},
     "effects": {"shipped": true}},
    {"event": "refund_partial", "label": "Hoàn một phần", "from_states": ["SUCCEEDED"], "to_state": "SUCCEEDED",
     "guard": {"and": ["$input.provider_verified", "$capture_verified", {"lt": ["$refunded_units", "$captured_units"]}, {"lt": [{"add": ["$refunded_units", 1]}, "$captured_units"]}]},
     "effects": {"refunded_units": {"add": ["$refunded_units", 1]}}},
    {"event": "refund_full", "label": "Hoàn toàn bộ phần còn lại", "from_states": ["SUCCEEDED"], "to_state": "REFUNDED",
     "guard": {"and": ["$input.provider_verified", "$capture_verified", {"lt": ["$refunded_units", "$captured_units"]}]},
     "effects": {"refunded_units": "$captured_units"}},
    {"event": "reconcile", "label": "Đối soát đơn đã thu tiền", "from_states": ["SUCCEEDED"], "to_state": "SUCCEEDED",
     "guard": {"and": ["$input.provider_verified", "$capture_verified", {"not": ["$reconciled"]}]},
     "effects": {"reconciled": true}},
    {"event": "reconcile_refunded", "label": "Đối soát đơn đã hoàn tiền", "from_states": ["REFUNDED"], "to_state": "REFUNDED",
     "guard": {"and": ["$input.provider_verified", {"not": ["$reconciled"]}]},
     "effects": {"reconciled": true}}
  ],
  "properties": [
    {"id": "no_unpaid_shipping", "label": "Chỉ giao hàng khi đã thu đủ tiền", "expression": {"implies": ["$shipped", {"and": ["$capture_verified", {"eq": ["$captured_units", 2]}]}]}},
    {"id": "no_over_refund", "label": "Không hoàn quá số tiền đã thu", "expression": {"le": ["$refunded_units", "$captured_units"]}},
    {"id": "capture_has_evidence", "label": "Đã thu tiền thì phải có bằng chứng hợp lệ", "expression": {"implies": [{"not": [{"le": ["$captured_units", 0]}]}, "$capture_verified"]}},
    {"id": "refund_after_capture", "label": "Chỉ hoàn tiền sau khi đã thu tiền", "expression": {"implies": [{"not": [{"le": ["$refunded_units", 0]}]}, "$capture_verified"]}},
    {"id": "success_has_evidence", "label": "Trạng thái thành công phải có bằng chứng thu tiền", "expression": {"implies": [{"eq": ["$status", "SUCCEEDED"]}, "$capture_verified"]}},
    {"id": "refunded_is_complete", "label": "Trạng thái đã hoàn tiền nghĩa là hoàn hết phần đã thu", "expression": {"implies": [{"eq": ["$status", "REFUNDED"]}, {"and": ["$capture_verified", {"eq": ["$refunded_units", "$captured_units"]}]}]}}
  ]
}
