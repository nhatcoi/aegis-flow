{
  "name": "Thanh toán ecommerce",
  "description": "Một đơn hàng, thanh toán toàn bộ. Mô hình hóa xác nhận thu tiền và quyền giao hàng; cổng thanh toán được giả lập.",
  "assumptions": [
    "Backend xác minh nguồn webhook, số tiền và loại tiền trước khi tạo các input boolean.",
    "captured_count đếm xác nhận thu tiền được mô hình hóa, không phải sổ cái độc lập của ngân hàng.",
    "Sự kiện được xử lý tuần tự theo đơn. Event ID được lưu bền vững để chống xử lý trùng.",
    "Chưa xét hoàn tiền, thanh toán một phần, nhiều cổng hoặc tính sống (liveness)."
  ],
  "variables": {
    "status": {"label": "Trạng thái thanh toán", "values": ["CREATED", "PENDING", "UNKNOWN", "SUCCEEDED", "FAILED"], "initial": "CREATED"},
    "captured_count": {"label": "Số xác nhận thu tiền", "values": [0, 1, 2], "initial": 0},
    "capture_verified": {"label": "Có bằng chứng thu tiền hợp lệ", "values": [false, true], "initial": false},
    "shipped": {"label": "Đã yêu cầu giao hàng", "values": [false, true], "initial": false}
  },
  "inputs": {
    "provider_verified": {"label": "Nguồn cổng đã xác thực", "values": [false, true], "initial": false},
    "amount_matches": {"label": "Số tiền khớp đơn hàng", "values": [false, true], "initial": false},
    "currency_matches": {"label": "Loại tiền khớp đơn hàng", "values": [false, true], "initial": false}
  },
  "transitions": [
    {"event": "start", "label": "Bắt đầu thanh toán", "from_states": ["CREATED"], "to_state": "PENDING", "guard": true, "effects": {}},
    {"event": "timeout", "label": "Mất phản hồi từ cổng", "from_states": ["PENDING"], "to_state": "UNKNOWN", "guard": true, "effects": {}},
    {"event": "confirm", "label": "Xác nhận thu tiền", "from_states": ["PENDING", "UNKNOWN"], "to_state": "SUCCEEDED", "guard": {"and": ["$input.provider_verified", "$input.amount_matches", "$input.currency_matches", {"eq": ["$captured_count", 0]}]}, "effects": {"capture_verified": true, "captured_count": {"add": ["$captured_count", 1]}}},
    {"event": "fail", "label": "Cổng xác nhận thất bại", "from_states": ["PENDING", "UNKNOWN"], "to_state": "FAILED", "guard": "$input.provider_verified", "effects": {}},
    {"event": "retry", "label": "Thử lại sau thất bại", "from_states": ["FAILED"], "to_state": "PENDING", "guard": {"eq": ["$captured_count", 0]}, "effects": {}},
    {"event": "ship", "label": "Yêu cầu giao hàng", "from_states": ["SUCCEEDED"], "to_state": "SUCCEEDED", "guard": {"and": ["$capture_verified", {"eq": ["$captured_count", 1]}, {"not": ["$shipped"]}]}, "effects": {"shipped": true}}
  ],
  "properties": [
    {"id": "no_unpaid_shipping", "label": "Chỉ giao hàng khi đã xác nhận thu tiền", "expression": {"implies": ["$shipped", {"and": ["$capture_verified", {"eq": ["$captured_count", 1]}]}]}},
    {"id": "at_most_one_capture", "label": "Tối đa một xác nhận thu tiền", "expression": {"le": ["$captured_count", 1]}},
    {"id": "success_has_evidence", "label": "Thành công phải có bằng chứng hợp lệ", "expression": {"implies": [{"eq": ["$status", "SUCCEEDED"]}, {"and": ["$capture_verified", {"eq": ["$captured_count", 1]}]}]}}
  ]
}
